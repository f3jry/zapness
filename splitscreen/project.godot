[layer_names]

2d_render/layer_2="player 1 portal visibility"
2d_render/layer_3="player 2 portal visibiility"
2d_physics/layer_1="player"
3d_physics/layer_1="default"
2d_physics/layer_2="portal 1"
2d_physics/layer_3="portal 2"
3d_physics/layer_4="portals"
2d_physics/layer_7="player only"
3d_physics/layer_7="With player only"
2d_physics/layer_8="portal block"

[physics]

2d/run_on_separate_thread=true
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.227451, 0.12549, 0.109804, 1)
